@startuml

' Styling for cleaner layout
hide circle
skinparam linetype ortho
skinparam EntityBackgroundColor #F9F9F9
skinparam EntityBorderColor #333333

entity "merchant" as merchant {
  * id : VARCHAR <<PK>>
  --
  * name : VARCHAR
}

entity "transaction" as transaction {
  * id : VARCHAR <<PK>>
  --
  * merchant_id : VARCHAR <<FK>> <<IDX>>
  * amount : DECIMAL(10, 2)
  * currency : VARCHAR
  * current_status : VARCHAR
  * last_event_timestamp : TIMESTAMPTZ 
  * created_at : TIMESTAMPTZ <<IDX>>
  * updated_at : TIMESTAMPTZ
}

entity "event" as event {
  * id : VARCHAR <<PK>>
  --
  * transaction_id : VARCHAR <<FK>> 
  * event_type : VARCHAR
  * timestamp : TIMESTAMPTZ 
  * created_at : TIMESTAMPTZ
  --
  **Indexes:**
  <<IDX>> composite (transaction_id, timestamp) INCLUDE (event_type)
}

' Relationships
merchant ||--o{ transaction : "1 to Many"
transaction ||--o{ event : "1 to Many"

@enduml